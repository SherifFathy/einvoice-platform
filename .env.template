# ==============================================================================
# E-Invoice Platform — Local Environment Template
# ==============================================================================
# USAGE:
#   cp .env.template .env
#   # Edit .env with your values, then:
#   docker compose up --build -d
#
# IMPORTANT: Never commit the .env file to version control.
#            This template file IS safe to commit (no real secrets).
# ==============================================================================


# ── Database ──────────────────────────────────────────────────────────────────
# Name of the PostgreSQL database created on first boot.
POSTGRES_DB=einvoice

# PostgreSQL credentials. Both the postgres container and the Spring Boot app
# use these variables — keep them in sync.
POSTGRES_USER=einvoice
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Host port that PostgreSQL is exposed on (container always listens on 5432).
# Change if 5433 is already in use on your machine.
POSTGRES_PORT=5433


# ── Spring Boot ───────────────────────────────────────────────────────────────
# Active Spring profile. Use "dev" for local Docker setups.
# Available profiles: dev | simulation | production
SPRING_PROFILES_ACTIVE=dev

# Host port that the Spring Boot application is exposed on.
APP_PORT=8080


# ── JWT ───────────────────────────────────────────────────────────────────────
# Base64-encoded HMAC-SHA256 secret used to sign and verify JWT tokens.
# Minimum recommended key length: 64 bytes (512 bits) before base64 encoding.
#
# Generate a fresh value with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(64)).decode())"
#
# Sandbox-only default (NOT safe for any shared or production environment):
JWT_SECRET=c2FuZGJveC1vbmx5LXNlY3JldC1rZXktZm9yLWxvY2FsLXRlc3Rpbmctb25seS1kb250LXVzZS1pbi1wcm9k
JWT_TTL_SECONDS=28800


# ── Field-Level Encryption ────────────────────────────────────────────────────
# Base64-encoded AES-256 master key (32 raw bytes → 44 base64 chars).
#
# Generate a fresh value with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#
# Sandbox-only default (NOT safe for any shared or production environment):
ENCRYPTION_MASTER_KEY=c2FuZGJveC1tYXN0ZXIta2V5LTMyYnl0ZXMtZG9udC11c2U=


# ── Bootstrap Super User (optional) ───────────────────────────────────────────
# When set, Flyway migration V44 seeds an initial Super User on first startup.
# If left empty, the migration is skipped silently (fine for most sandbox runs).
#
# Generate a BCrypt hash with:
#   htpasswd -bnBC 12 "" "YourPassword" | tr -d ':\n'
#   # or via Spring Security's BCryptPasswordEncoder in any Java shell
BOOTSTRAP_SUPERUSER_EMAIL=admin@einvoice.local
BOOTSTRAP_SUPERUSER_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
