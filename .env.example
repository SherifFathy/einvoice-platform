# einvoice-platform environment variables
# Copy to .env and fill in real values before starting the backend.
#   cp .env.example .env
#
# The backend reads these via Spring Boot's ${VAR} substitution in application.yml.
# Do NOT commit .env to version control.

# --- JWT ---
# Base64-encoded HMAC-SHA256 secret for JWT signing.
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(64)).decode())"
JWT_SECRET=REPLACE_WITH_BASE64_SECRET

# JWT access-token lifetime in seconds. Accepted range: [60, 86400].
# Default: 28800 (8 hours).
JWT_TTL_SECONDS=28800

# --- Bootstrap Super User ---
# Both must be set for the Flyway migration (V44__bootstrap_super_user.sql)
# to seed the initial Super User. If either is unset or still contains the
# REPLACE_WITH placeholder, the migration logs a warning and skips insertion
# (intended for CI/test environments).
BOOTSTRAP_SUPERUSER_EMAIL=REPLACE_WITH_SUPERUSER_EMAIL
# BCrypt hash of the desired password. See Docs/configuration-reference.md for
# generation recipes (Unix and Windows).
BOOTSTRAP_SUPERUSER_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# --- Encryption ---
# Base64-encoded master key for field-level encryption.
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_MASTER_KEY=REPLACE_WITH_BASE64_KEY
